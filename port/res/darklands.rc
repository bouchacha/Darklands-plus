/* darklands.rc - the Windows program's icon (tools/make_icon.py) and version information */
#include <winver.h>
1 ICON "darklands.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Darklands+"
      VALUE "FileDescription", "Darklands+"
      VALUE "FileVersion", DLP_VERSION
      VALUE "ProductVersion", DLP_VERSION
      VALUE "OriginalFilename", "darklands.exe"
      VALUE "Comments", "Runs your own copy of Darklands (MicroProse, 1992) natively, with optional improvements."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
