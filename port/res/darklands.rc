/* darklands.rc - the Windows program's icon (tools/make_icon.py) and version information */
#include <winver.h>
1 ICON "darklands.ico"
/* the program's code page UTF-8 (Windows 10 1903 and later): the paths SDL gives are UTF-8 and every file call is the
   ANSI one, so a folder with a letter outside the system's code page (C:\Users\Jürgen on many systems) was not found:
   the game module could not be made and nothing started (the audit, 2026-11-22) */
1 24 "darklands.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Darklands+"
      VALUE "FileDescription", "Darklands+"
      VALUE "FileVersion", DLP_VERSION
      VALUE "ProductVersion", DLP_VERSION
      VALUE "OriginalFilename", "darklands.exe"
      VALUE "Comments", "Runs your own copy of Darklands (MicroProse, 1992) natively, with optional improvements."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
